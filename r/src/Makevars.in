OBJECTS = taco.o @NATIVE_OBJECTS@

PKG_CXXFLAGS = @TACO_CXX23_FLAG@

PKG_CPPFLAGS = \
    -include taco_versions.h \
    -DTACO_BUILD \
    -DKARU_STATIC \
    -D_FILE_OFFSET_BITS=64 \
    -Ivendor/taco/include \
    -Ivendor/taco/src \
    -Ivendor/karu/include \
    -Ivendor/karu/src \
    @DEPENDENCY_CPPFLAGS@
PKG_LIBS = @DEPENDENCY_LIBS@ -pthread
